{
  "name": "astack",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable primitives and orchestration for coding agents",
  "license": "MIT",
  "bin": {
    "astack": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node --import tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "clean": "node tools/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node tools/prepare-bin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 src tests tools",
    "lint:fix": "oxfmt --write . && oxlint --type-aware --fix --max-warnings 0 src tests tools && oxfmt --write .",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm build && node --import tsx --test tests/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0"
}
